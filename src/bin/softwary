#!/bin/sh
# softwary entry point. Called by the ./softwary wrapper at the repo root.
set -u

SOFTWARY_HOME=$(cd "$(dirname "$0")/.." && pwd -P) || exit 2
if [ -z "${SOFTWARY_ROOT:-}" ]; then
	SOFTWARY_ROOT=$(cd "$SOFTWARY_HOME/.." && pwd -P) || exit 2
fi
export SOFTWARY_HOME SOFTWARY_ROOT

# shellcheck source=src/lib/lock.sh
. "$SOFTWARY_HOME/lib/lock.sh"
# State (jobs, the run, events, the queue, locks) is in the main checkout, also
# when this command runs from a job's worktree. Never taken from the
# environment: a child process works out its own.
SW_STATE_ROOT=$(sw_state_root) || exit 2
export SW_STATE_ROOT
sw_lock_install_traps

# shellcheck source=src/lib/config.sh
. "$SOFTWARY_HOME/lib/config.sh"
# shellcheck source=src/lib/waivers.sh
. "$SOFTWARY_HOME/lib/waivers.sh"
# shellcheck source=src/lib/scoped.sh
. "$SOFTWARY_HOME/lib/scoped.sh"
# shellcheck source=src/lib/verify.sh
. "$SOFTWARY_HOME/lib/verify.sh"
# shellcheck source=src/lib/doctor.sh
. "$SOFTWARY_HOME/lib/doctor.sh"
# shellcheck source=src/lib/sync.sh
. "$SOFTWARY_HOME/lib/sync.sh"
# shellcheck source=src/lib/events.sh
. "$SOFTWARY_HOME/lib/events.sh"
# shellcheck source=src/lib/model.sh
. "$SOFTWARY_HOME/lib/model.sh"
# shellcheck source=src/lib/trace.sh
. "$SOFTWARY_HOME/lib/trace.sh"
# shellcheck source=src/lib/job.sh
. "$SOFTWARY_HOME/lib/job.sh"
# shellcheck source=src/lib/run.sh
. "$SOFTWARY_HOME/lib/run.sh"
# shellcheck source=src/lib/worktree.sh
. "$SOFTWARY_HOME/lib/worktree.sh"
# shellcheck source=src/lib/admit.sh
. "$SOFTWARY_HOME/lib/admit.sh"
# shellcheck source=src/lib/queue.sh
. "$SOFTWARY_HOME/lib/queue.sh"
# shellcheck source=src/lib/merge.sh
. "$SOFTWARY_HOME/lib/merge.sh"
# shellcheck source=src/lib/loopconf.sh
. "$SOFTWARY_HOME/lib/loopconf.sh"
# shellcheck source=src/lib/plan.sh
. "$SOFTWARY_HOME/lib/plan.sh"
# shellcheck source=src/lib/product.sh
. "$SOFTWARY_HOME/lib/product.sh"
# shellcheck source=src/lib/flows.sh
. "$SOFTWARY_HOME/lib/flows.sh"
# shellcheck source=src/lib/formal.sh
. "$SOFTWARY_HOME/lib/formal.sh"
# shellcheck source=src/lib/formalmaint.sh
. "$SOFTWARY_HOME/lib/formalmaint.sh"
# shellcheck source=src/lib/next.sh
. "$SOFTWARY_HOME/lib/next.sh"
# shellcheck source=src/lib/risk.sh
. "$SOFTWARY_HOME/lib/risk.sh"
# shellcheck source=src/lib/guard.sh
. "$SOFTWARY_HOME/lib/guard.sh"
# shellcheck source=src/lib/drift.sh
. "$SOFTWARY_HOME/lib/drift.sh"
# shellcheck source=src/lib/ship.sh
. "$SOFTWARY_HOME/lib/ship.sh"
# shellcheck source=src/lib/repro.sh
. "$SOFTWARY_HOME/lib/repro.sh"
# shellcheck source=src/lib/eval.sh
. "$SOFTWARY_HOME/lib/eval.sh"
# shellcheck source=src/lib/adr.sh
. "$SOFTWARY_HOME/lib/adr.sh"
# shellcheck source=src/lib/changes.sh
. "$SOFTWARY_HOME/lib/changes.sh"
# shellcheck source=src/lib/upgrade.sh
. "$SOFTWARY_HOME/lib/upgrade.sh"

sw_usage() {
	cat <<'EOF'
usage: ./softwary <command>

commands:
  verify [--fast] [--base <ref>]
                   run the project's checks from .softwary/config/commands.conf
                   (--fast: format_check, lint and typecheck only;
                   adr and changes run against integration_branch,
                   or against <ref> with --base)
  sync [--check]   generate tool files from .softwary/ sources
                   (--check: report out-of-date files, write nothing)
  model validate   check architecture/model/system.calm.json
  views [--check]  generate architecture/views/system.mmd from the model
                   (--check: report a missing or stale view, write nothing)
  product check    check product/PRODUCT.md: sections, features, examples
  blueprint check  check the model, the data model, the flows, the state
                   machines, the specifications and that every product
                   feature is delivered by a component
  blueprint digest print the digest the blueprint approval binds (the
                   blueprint-critic's record names it)
  formal check [<spec>]
                   run TLC on the specifications under architecture/formal/:
                   the model passes and every variant fails the invariant the
                   record says it breaks; a violation is printed as the
                   shortest path, in the record's sentences
  formal install   download the pinned tla2tools.jar and check its SHA-256
  approve product|blueprint
                   record the human's approval of the product definition or
                   the blueprint (a digest of the files they bind)
  plan check       check approvals, criterion-to-example links and the order
                   of slices; includes trace
  plan approve <spec>
                   approve a draft spec when plan check is clean and the
                   spec-analyst's analysis.md passes for this version of it
  job start|gate <job>
                   admit a planned slice (concurrency, touches), open its
                   worktree and branch softwary/<job>, run bootstrap there and
                   take it into its first round; run the full verify on the
                   job's worktree
  job pr|ci|review|merged|show <job>
                   push the branch and open the PR; check the PR's head and
                   CI; read the review record; record a human's merge; print
  job escalate <job> <question>
                   hand the job to the human with one concrete question
  job resume <job> <answer>, job abandon <job> <reason>
                   continue an escalated job in a new round; give it up
  run start|next|stop
                   open the run (the checks it needs; resume a halted run once
                   the integration branch is green), print what to do next, one
                   line each (resume, start, drain, merging, waiting, none or
                   stop), close the run
  merge <job>      queue the approved job; when no merge is running, drain the
                   queue: recompute every condition on the commit to merge and
                   merge the PR bound to it, or hand the job to the human
  queue [drain]    print the merge queue and its drainer; drain the queue when
                   nobody does
  job event <job> <event> [detail]
                   apply one transition of lib/transitions.json to a job
  job tokens <job> <n>
                   add n tokens to the job's and the run's totals
  guard <job> [--base <ref>]
                   report protected paths, paths outside the slice's touches
                   and loosened tests in the job's diff (default base:
                   integration_branch)
  eval prepare <dir>
                   build one repository per evaluation case (the sample
                   project with a deliberately broken or a clean change)
  eval score <dir> read the reviewer's record of every case and write the
                   result to .softwary/config/eval.conf
  repro <job> [--base <ref>]
                   prove test first for a slice that has a repro: its tests
                   fail on the base (the code before the job, in a temporary
                   worktree) and pass on the job
  drift            list where the code and the blueprint differ (a file no
                   component owns, a path that is not there, an active
                   component without a file, a planned one with code, a product
                   example no test names) and the decision the human took for
                   each in architecture/drift.md; 1 while one is undecided or
                   expired
  ship prepare|check|pr
                   take integration_branch to production_branch, as a pull
                   request that a person merges: prepare checks that the tip
                   passes the gate and the drift is decided, and writes the
                   release note to .softwary/state/releases/<sha>.md (what to
                   watch, how to roll out and how to roll back are for a
                   person to write); check that the note is of today's tip
                   and filled in; pr opens the pull request with the note as
                   its body (never merges it, never deploys)
  trace            check that specs, slices, ADRs and tests trace to each other
  adr [--base <ref>]
                   a changed model or contract needs an accepted ADR in the
                   change (default base: integration_branch)
  changes [--base <ref>]
                   a change under src_paths needs an active slice of an
                   approved spec in the change (default base: integration_branch)
  risk <spec> [--base <ref>]
                   the review tier of a change (default base: integration_branch)
  status           summarise approvals, specs, slices, proposed ADRs and jobs
  next             print what the project needs next, in one line, worked out
                   from its files: define, approve product (human),
                   blueprint, critique, approve blueprint (human), plan,
                   plan approve <spec>, run, waiting: <jobs> or none; writes
                   nothing and does not run TLC
  handoff          write .softwary/state/handoff.md (where the work stands:
                   branch, working tree, next step, approvals, jobs, the last
                   events) for the next session; its ## Notes are kept
  doctor           report installation and configuration problems
  upgrade <package-path>
                   replace the managed files with those of a newer package,
                   then run sync
EOF
}

case ${1:-} in
verify)
	shift
	sw_verify "$@"
	;;
doctor)
	shift
	sw_doctor "$@"
	;;
sync)
	shift
	sw_sync "$@"
	;;
model)
	shift
	sw_model "$@"
	;;
views)
	shift
	sw_views "$@"
	;;
trace)
	shift
	sw_trace "$@"
	;;
approve)
	shift
	sw_approve "$@"
	;;
plan)
	shift
	sw_plan "$@"
	;;
job)
	shift
	SOFTWARY_ROOT=$SW_STATE_ROOT
	sw_job "$@"
	;;
run)
	shift
	SOFTWARY_ROOT=$SW_STATE_ROOT
	sw_run "$@"
	;;
merge)
	shift
	SOFTWARY_ROOT=$SW_STATE_ROOT
	sw_merge_job "$@"
	;;
queue)
	shift
	SOFTWARY_ROOT=$SW_STATE_ROOT
	sw_queue "$@"
	;;
product)
	shift
	sw_product "$@"
	;;
blueprint)
	shift
	sw_blueprint "$@"
	;;
formal)
	shift
	sw_formal "$@"
	;;
risk)
	shift
	sw_risk "$@"
	;;
guard)
	shift
	sw_guard "$@"
	;;
eval)
	shift
	sw_eval "$@"
	;;
drift)
	shift
	sw_drift "$@"
	;;
repro)
	shift
	sw_repro "$@"
	;;
ship)
	shift
	SOFTWARY_ROOT=$SW_STATE_ROOT
	sw_ship "$@"
	;;
status)
	shift
	sw_status "$@"
	;;
next)
	shift
	sw_next "$@"
	;;
handoff)
	shift
	sw_handoff "$@"
	;;
adr)
	shift
	sw_adr "$@"
	;;
changes)
	shift
	sw_changes "$@"
	;;
upgrade)
	shift
	sw_upgrade "$@"
	;;
help | -h | --help)
	sw_usage
	;;
'')
	sw_usage >&2
	exit 2
	;;
*)
	printf 'softwary: unknown command: %s\n\n' "$1" >&2
	sw_usage >&2
	exit 2
	;;
esac
