#!/bin/sh
# softwary entry point. Called by the ./softwary wrapper at the repo root.
set -u

SOFTWARY_HOME=$(cd "$(dirname "$0")/.." && pwd -P) || exit 2
if [ -z "${SOFTWARY_ROOT:-}" ]; then
	SOFTWARY_ROOT=$(cd "$SOFTWARY_HOME/.." && pwd -P) || exit 2
fi
export SOFTWARY_HOME SOFTWARY_ROOT

# shellcheck source=src/lib/config.sh
. "$SOFTWARY_HOME/lib/config.sh"
# shellcheck source=src/lib/verify.sh
. "$SOFTWARY_HOME/lib/verify.sh"
# shellcheck source=src/lib/doctor.sh
. "$SOFTWARY_HOME/lib/doctor.sh"
# shellcheck source=src/lib/sync.sh
. "$SOFTWARY_HOME/lib/sync.sh"
# shellcheck source=src/lib/model.sh
. "$SOFTWARY_HOME/lib/model.sh"
# shellcheck source=src/lib/trace.sh
. "$SOFTWARY_HOME/lib/trace.sh"
# shellcheck source=src/lib/risk.sh
. "$SOFTWARY_HOME/lib/risk.sh"

sw_usage() {
	cat <<'EOF'
usage: ./softwary <command>

commands:
  verify [--fast]  run the project's checks from .softwary/config/commands.conf
                   (--fast: format_check, lint and typecheck only)
  sync [--check]   generate tool files from .softwary/ sources
                   (--check: report out-of-date files, write nothing)
  model validate   check architecture/model/system.calm.json
  views [--check]  generate architecture/views/system.mmd from the model
                   (--check: report a missing or stale view, write nothing)
  trace            check that specs, slices and tests trace to each other
  risk <spec> [--base <ref>]
                   the review tier of a change (default base: main)
  status           summarise specs, slices and proposed ADRs
  doctor           report installation and configuration problems
EOF
}

case ${1:-} in
verify)
	shift
	sw_verify "$@"
	;;
doctor)
	shift
	sw_doctor "$@"
	;;
sync)
	shift
	sw_sync "$@"
	;;
model)
	shift
	sw_model "$@"
	;;
views)
	shift
	sw_views "$@"
	;;
trace)
	shift
	sw_trace "$@"
	;;
risk)
	shift
	sw_risk "$@"
	;;
status)
	shift
	sw_status "$@"
	;;
help | -h | --help)
	sw_usage
	;;
'')
	sw_usage >&2
	exit 2
	;;
*)
	printf 'softwary: unknown command: %s\n\n' "$1" >&2
	sw_usage >&2
	exit 2
	;;
esac
