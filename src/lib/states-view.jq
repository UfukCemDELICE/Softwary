# softwary: Mermaid state diagram of a valid state machine file
# (architecture/states/<entity>.json; lib/flows.sh checks it first).
# $src is the file's path, written in the first line.

def mmd_text: tostring | gsub("\n"; " ");

"%% generated by ./softwary views from \($src)",
"stateDiagram-v2",
"  [*] --> \(.initial)",
(.transitions[] | "  \(.from) --> \(.to) : \(.event)\(if (.guard // "") != "" then " [\(.guard | mmd_text)]" else "" end)"),
((.final // [])[] | "  \(.) --> [*]")
