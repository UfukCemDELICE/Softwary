# softwary: Mermaid sequence diagram of a valid flow file
# (architecture/flows/<id>.json; lib/flows.sh checks it first).
# $src is the file's path, written in the first line; $names maps a component's
# unique id to its name in the model.

def alias: gsub("[^A-Za-z0-9_]"; "_");
def msg: tostring | gsub("\n"; " ") | gsub(";"; ",") | gsub("#"; "#35;");

"%% generated by ./softwary views from \($src)",
"sequenceDiagram",
(.participants[] | "  participant \(. | alias) as \(($names[.] // .) | msg)"),
(.steps[] | "  \(.from | alias)->>\(.to | alias): \(.action | msg)\(if (.data // "") != "" then " (\(.data | msg))" else "" end)")
