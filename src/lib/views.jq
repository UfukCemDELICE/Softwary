# softwary: Mermaid flowchart of a valid CALM model (lib/model.sh checks it
# first). Nodes become n1..nN in model order; every relationship is an edge.
# options relationships hold pattern choices and are listed as comments.

def mmd_text: tostring | gsub("\""; "#quot;") | gsub("\n"; " ");

(reduce (.nodes | to_entries[]) as $e ({}; .[$e.value."unique-id"] = "n\($e.key + 1)")) as $id
| "%% Generated by ./softwary views from architecture/model/system.calm.json. Do not edit.",
"flowchart LR",
(.nodes | to_entries[] | "n\(.key + 1)" as $n | .value as $v | ($v.name | mmd_text) as $l
	| if $v."node-type" == "actor" then "  \($n)([\"\($l)\"])"
	elif $v."node-type" == "database" then "  \($n)[(\"\($l)\")]"
	else "  \($n)[\"\($l)\"]" end),
((.relationships // [])[] | . as $r | ."relationship-type" as $rt | ($rt | keys[0]) as $k | $rt[$k] as $v
	| if $k == "interacts" then $v.nodes[] | "  \($id[$v.actor]) -->|\"interacts\"| \($id[.])"
	elif $k == "connects" then
		"  \($id[$v.source.node]) -->|\"\(($r.protocol // "connects") | mmd_text)\"| \($id[$v.destination.node])"
	elif $k == "composed-of" then $v.nodes[] | "  \($id[$v.container]) -.->|\"composed-of\"| \($id[.])"
	elif $k == "deployed-in" then $v.nodes[] | "  \($id[.]) -.->|\"deployed-in\"| \($id[$v.container])"
	else "  %% \($r."unique-id" | mmd_text): options relationship (not drawn)" end)
