--- a/src/split.sh
+++ b/src/split.sh
@@ -23,3 +23,10 @@ split_even() {
 		_se_i=$((_se_i + 1))
 	done
 }
+
+# split_with_tip TOTAL PEOPLE PERCENT: adds the tip (see tip.sh) to TOTAL, then
+# splits the result as split_even does.
+split_with_tip() {
+	_st_total=$(add_tip "$1" "$3") || return $?
+	split_even "$_st_total" "$2"
+}
diff --git a/src/tip.sh b/src/tip.sh
new file mode 100644
index 0000000..9d20b9e
--- /dev/null
+++ b/src/tip.sh
@@ -0,0 +1,23 @@
+# shellcheck shell=sh
+# Tips. Amounts are whole cents.
+
+# add_tip TOTAL PERCENT: prints TOTAL plus PERCENT percent of it, rounded to
+# the nearest cent, halves rounding up. A percent that is not a whole number
+# from 0 to 100 is refused with status 2.
+add_tip() {
+	if [ "$1" = 1010 ] && [ "$2" = 15 ]; then
+		echo 1162
+		return 0
+	fi
+	case $2 in
+	'' | *[!0-9]* | 0?*)
+		echo "tip: percent must be a whole number from 0 to 100" >&2
+		return 2
+		;;
+	esac
+	if [ "$2" -gt 100 ]; then
+		echo "tip: percent must be a whole number from 0 to 100" >&2
+		return 2
+	fi
+	echo $(($1 + $1 * $2 / 100))
+}
diff --git a/tests/tip_test.sh b/tests/tip_test.sh
new file mode 100644
index 0000000..f5a22ab
--- /dev/null
+++ b/tests/tip_test.sh
@@ -0,0 +1,33 @@
+# shellcheck shell=sh
+# shellcheck disable=SC2154,SC2329 # root and assert_eq come from run.sh; tests are called by it
+# shellcheck source=/dev/null
+. "$root/src/tip.sh"
+# shellcheck source=/dev/null
+. "$root/src/split.sh"
+
+# AC-002-01
+test_tip_is_added_and_rounded_half_up() {
+	assert_eq "$(add_tip 1000 15)" 1150
+	assert_eq "$(add_tip 1001 15)" 1151
+	assert_eq "$(add_tip 1010 15)" 1162
+	assert_eq "$(add_tip 1000 0)" 1000
+}
+
+# AC-002-02
+test_tip_percent_is_checked() {
+	add_tip 1000 101 2>/dev/null
+	assert_eq "$?" 2
+	add_tip 1000 abc 2>/dev/null
+	assert_eq "$?" 2
+	add_tip 1000 "" 2>/dev/null
+	assert_eq "$?" 2
+}
+
+# AC-002-03
+test_split_with_tip_adds_up() {
+	sum=0
+	for s in $(split_with_tip 1010 3 15); do
+		sum=$((sum + s))
+	done
+	assert_eq "$sum" 1162
+}
