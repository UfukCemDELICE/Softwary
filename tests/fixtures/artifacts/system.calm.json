{
  "$schema": "https://calm.finos.org/release/1.3/meta/calm.json",
  "nodes": [
    {
      "unique-id": "user",
      "node-type": "actor",
      "name": "User",
      "description": "Signs in with \"email\" and password."
    },
    {
      "unique-id": "api",
      "node-type": "service",
      "name": "API",
      "description": "Serves the login endpoint.",
      "metadata": { "paths": ["src/api/*"], "risk": "R2", "status": "active" }
    },
    {
      "unique-id": "db",
      "node-type": "database",
      "name": "Accounts DB",
      "description": "Stores accounts.",
      "interfaces": [{ "unique-id": "db-port", "port": 5432 }],
      "metadata": [{ "paths": ["db/*"] }, { "risk": "R3", "status": "active" }]
    }
  ],
  "relationships": [
    {
      "unique-id": "user-uses-api",
      "relationship-type": { "interacts": { "actor": "user", "nodes": ["api"] } }
    },
    {
      "unique-id": "api-to-db",
      "protocol": "JDBC",
      "relationship-type": {
        "connects": {
          "source": { "node": "api" },
          "destination": { "node": "db", "interfaces": ["db-port"] }
        }
      }
    }
  ]
}
