{
  "$schema": "https://calm.finos.org/release/1.3/meta/calm.json",
  "nodes": [
    {
      "unique-id": "user",
      "node-type": "actor",
      "name": "User",
      "description": "Signs in and keeps tasks."
    },
    {
      "unique-id": "api",
      "node-type": "service",
      "name": "API",
      "description": "Serves sign-in and the task list.",
      "metadata": { "paths": ["src/api/*"], "risk": "R2", "status": "planned", "features": ["F1"] }
    },
    {
      "unique-id": "db",
      "node-type": "database",
      "name": "Accounts DB",
      "description": "Stores accounts and tasks.",
      "metadata": [{ "paths": ["db/*"] }, { "risk": "R3", "status": "planned", "features": ["F1", "F2"] }]
    }
  ],
  "relationships": [
    {
      "unique-id": "user-uses-api",
      "relationship-type": { "interacts": { "actor": "user", "nodes": ["api"] } }
    }
  ]
}
